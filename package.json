{
  "name": "pgcc-certification-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "wrangler dev --port 8787",
    "deploy:api": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply pgcc-cert-tracker --local",
    "db:remote": "wrangler d1 migrations apply pgcc-cert-tracker --remote",
    "test": "node --test tests/*.test.js",
    "check": "node --check worker/index.js && node --check frontend/app.js"
  },
  "devDependencies": { "wrangler": "^4.0.0" }
}
